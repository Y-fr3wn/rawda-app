+// A Rawda-original interpretation of modern pilgrimage-app navigation.
+// All controls invoke existing Rawda functions: no placeholder tiles.
+extension RawdaJourneyHome on RawdaState {
+  Widget _journeyHeading(String title, String subtitle, {VoidCallback? onMore}) {
+    return Padding(
+      padding: const EdgeInsets.only(top: 20, bottom: 13),
+      child: Row(
+        crossAxisAlignment: CrossAxisAlignment.center,
+        children: [
+          Expanded(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(title, style: const TextStyle(fontSize: 19, fontWeight: FontWeight.w800)),
+                const SizedBox(height: 3),
+                Text(subtitle, style: TextStyle(fontSize: 11, color: Theme.of(nav.currentContext!).colorScheme.onSurfaceVariant)),
+              ],
+            ),
+          ),
+          if (onMore != null)
+            TextButton.icon(
+              onPressed: onMore,
+              icon: const Icon(Icons.arrow_forward_ios_rounded, size: 12),
+              label: Text(tr('عرض الكل', 'See all'), style: const TextStyle(fontSize: 11)),
+            ),
+        ],
+      ),
+    );
+  }
+
+  Widget _journeyAction(String title, IconData icon, VoidCallback onPressed, Color tint) {
+    return Material(
+      color: dark ? const Color(0xFF203B32) : const Color(0xFFFFFFFF),
+      borderRadius: BorderRadius.circular(20),
+      child: InkWell(
+        onTap: onPressed,
+        borderRadius: BorderRadius.circular(20),
+        child: Container(
+          padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 14),
+          decoration: BoxDecoration(
+            border: Border.all(color: rawdaGold.withValues(alpha: .18)),
+            borderRadius: BorderRadius.circular(20),
+          ),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            children: [
+              Container(
+                width: 49,
+                height: 49,
+                decoration: BoxDecoration(color: tint.withValues(alpha: dark ? .25 : .10), borderRadius: BorderRadius.circular(17)),
+                child: Icon(icon, color: dark ? rawdaGold : tint, size: 25),
+              ),
+              const SizedBox(height: 10),
+              Text(title, textAlign: TextAlign.center, maxLines: 2,
+                  overflow: TextOverflow.ellipsis,
+                  style: const TextStyle(fontSize: 11, height: 1.5, fontWeight: FontWeight.w700)),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget journeyQuickActions() {
+    const sage = Color(0xFF315C4C);
+    const bronze = Color(0xFF9F7B41);
+    const warm = Color(0xFFB57948);
+    const sea = Color(0xFF4D7672);
+    final items = <(String, IconData, VoidCallback, Color)>[
+      (tr('القرآن الكريم', 'Holy Quran'), Icons.menu_book_rounded, openQuran, sage),
+      (tr('مواقيت الصلاة', 'Prayer times'), Icons.mosque_outlined, openPrayerMonth, bronze),
+      (tr('الأذكار', 'Daily adhkar'), Icons.spa_outlined, () => openAdhkar('morning'), sea),
+      (tr('اتجاه القبلة', 'Qibla direction'), Icons.explore_outlined, openQibla, sage),
+      (tr('المسابقة اليومية', 'Daily quiz'), Icons.emoji_events_outlined, () { mutate(() => page = 2); loadQuiz(); }, warm),
+      (tr('ورد اليوم', 'Daily reading'), Icons.auto_stories_outlined, openDaily, bronze),
+    ];
+    return LayoutBuilder(builder: (context, constraints) {
+      final spacing = 10.0;
+      final tileWidth = (constraints.maxWidth - spacing * 2) / 3;
+      return Wrap(
+        spacing: spacing,
+        runSpacing: 10,
+        children: [
+          for (final item in items)
+            SizedBox(width: tileWidth, child: _journeyAction(item.$1, item.$2, item.$3, item.$4)),
+        ],
+      );
+    });
+  }
