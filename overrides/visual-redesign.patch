+              style: const TextStyle(color: Color(0xFFEEE4D2), fontSize: 11))),
+          const SizedBox(width: 6),
+          Text('${now.hour.toString().padLeft(2,'0')}:${now.minute.toString().padLeft(2,'0')}',
+              style: const TextStyle(fontFamily: 'RawdaLatin', color: Colors.white, fontSize: 13, fontWeight: FontWeight.w700)),
+        ]),
+        const SizedBox(height: 15),
+        Row(children: [
+          Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+            Text(tr('الصلاة القادمة', 'Next prayer'),
+                style: const TextStyle(fontSize: 12, color: Color(0xFFE5D1AB))),
+            const SizedBox(height: 2),
